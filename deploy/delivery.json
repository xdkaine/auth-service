{
  "repository": "xdkaine/auth-service",
  "schemaInputs": {
    "auth": [
      "prisma",
      "prisma.config.ts"
    ]
  },
  "images": [
    {
      "kind": "auth",
      "image": "ghcr.io/xdkaine/auth-service",
      "context": ".",
      "dockerfile": "Dockerfile",
      "target": "runner",
      "buildArgs": ""
    },
    {
      "kind": "auth-migrate",
      "image": "ghcr.io/xdkaine/auth-service-migrate",
      "context": ".",
      "dockerfile": "Dockerfile",
      "target": "migration-tool",
      "buildArgs": ""
    }
  ]
}

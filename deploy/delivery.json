{
  "repository": "xdkaine/auth-service",
  "schemaInputs": {
    "auth": [
      "prisma",
      "prisma.config.ts"
    ]
  },
  "images": [
    {
      "kind": "auth",
      "image": "ghcr.io/xdkaine/auth-service",
      "context": ".",
      "dockerfile": "Dockerfile",
      "target": "runner",
      "buildArgs": ""
    },
    {
      "kind": "auth-migrate",
      "image": "ghcr.io/xdkaine/auth-service-migrate",
      "context": ".",
      "dockerfile": "Dockerfile",
      "target": "migration-tool",
      "buildArgs": ""
    }
  ],
  "reusableImageInputs": {
    "auth-migrate": [
      "prisma",
      "prisma.config.ts",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      ".dockerignore",
      "tsconfig.json",
      "scripts",
      "eslint.config.mjs",
      "deploy/delivery.json",
      ".github/workflows/delivery.yml"
    ]
  }
}
